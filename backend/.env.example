ENV=development

DATABASE_URL=postgresql+psycopg2://sentinel:sentinel@postgis:5432/sentinel
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sentinel-evidence
MINIO_SECURE=false

LOCAL_EVIDENCE_FALLBACK_DIR=./data/evidence_fallback

ALERT_COOLDOWN_SECONDS=300
CORS_ALLOW_ORIGINS=["*"]
