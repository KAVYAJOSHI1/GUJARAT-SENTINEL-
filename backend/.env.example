ENV=development

DATABASE_URL=postgresql+psycopg2://sentinel:sentinel@postgis:5432/sentinel
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
# Recycle a pooled connection after N seconds (replaces one silently dropped
# by an idle timeout). 0 disables.
DB_POOL_RECYCLE_SECONDS=1800
# Server-side per-statement ceiling in ms (a runaway query is cancelled
# instead of pinning a pooled connection). 0 disables.
DB_STATEMENT_TIMEOUT_MS=15000

JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Login brute-force throttle (per backend process; see SECURITY.md §1.8)
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_MAX_FAILURES=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_BLOCK_SECONDS=300

# Short-lived, single-purpose transport tickets (WS handshake / media <img> src)
WS_TICKET_TTL_SECONDS=60
MEDIA_TICKET_TTL_SECONDS=120

# vehicle_events retention: purge rows older than N days (0 = disabled).
# Alert-referenced rows are never purged; watchlist/alerts/audit_logs untouched.
VEHICLE_EVENT_RETENTION_DAYS=30
RETENTION_SWEEP_INTERVAL_HOURS=24
RETENTION_SWEEP_ENABLED=true

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sentinel-evidence
MINIO_SECURE=false

LOCAL_EVIDENCE_FALLBACK_DIR=./data/evidence_fallback

ALERT_COOLDOWN_SECONDS=300
# Explicit CORS origin allow-list. "*" is honoured ONLY when ENV is a
# development value (development/dev/local/test) -- otherwise it is dropped
# with a warning. The dashboard normally reaches the API same-origin via the
# Vite/prod proxy, so this only matters for direct cross-origin API access.
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Shared secret the AI pipeline sends as X-Ingest-Key on
# POST /api/v1/events/ai-detection. Leave blank to require an operator JWT
# instead. Set the SAME value as SENTINEL_INGEST_API_KEY on the AI side.
INGEST_API_KEY=
INGEST_AUTO_ONBOARD_CAMERAS=true

# --- initial seed (scripts/seed_db.py) — placeholders only, never commit real values ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@sentinel.local
ADMIN_PASSWORD=
ADMIN_ROLE=ADMIN
# optional demo watchlist plate to seed
SEED_WATCHLIST_PLATE=
