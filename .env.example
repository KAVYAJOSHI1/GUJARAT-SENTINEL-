# SENTINEL Platform Environment Configuration Template

# General Environment
ENV=production
DEBUG=false
SECRET_KEY=sentinel_gujarat_police_hackathon_2026_secret_key

# PostgreSQL + PostGIS Database
POSTGRES_USER=sentinel_admin
POSTGRES_PASSWORD=sentinel_secure_pass_2026
POSTGRES_DB=sentinel_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=sentinel_minio_admin
MINIO_SECRET_KEY=sentinel_minio_secret_2026
MINIO_BUCKET_NAME=sentinel-evidence

# Service Ports
BACKEND_PORT=8000
INGESTION_PORT=8001
FRONTEND_PORT=3000

# --- docker compose host ports (override to avoid clashes with local services) ---
POSTGRES_HOST_PORT=5432
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# --- docker compose seed / auth (placeholders — real values go in .env, never committed) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@sentinel.local
ADMIN_PASSWORD=
SEED_WATCHLIST_PLATE=
INGEST_API_KEY=dev-ingest-key
PIPELINE_CAMERAS=cam04,cam06

# Stream Ingestion Default Transport
OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp

# Sentinel RTSP Basic-auth credentials (the RTSP server answers 401 without them).
# Injected into the stream URL just before cv2.VideoCapture(); never logged,
# never sent to the frontend. Leave blank to use unauthenticated streams / local files.
SENTINEL_RTSP_USERNAME=
SENTINEL_RTSP_PASSWORD=
# Base used when a camera has no rtsp_url in the registry: <base>/<camera_id>
SENTINEL_RTSP_BASE=rtsp://103.250.160.189:8554/stream

# AI pipeline -> backend
SENTINEL_BACKEND_URL=http://localhost:8000/api/v1/events/ai-detection
# Must match the backend's INGEST_API_KEY. Blank -> pipeline sends no auth header.
SENTINEL_INGEST_API_KEY=
# OCR backend: easyocr (default) | paddleocr | auto
OCR_ENGINE=easyocr
