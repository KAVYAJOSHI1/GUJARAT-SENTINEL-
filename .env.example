# SENTINEL — local .env template.
#
#   cp .env.example .env      # then edit the values below
#
# Every value here is a NON-SECRET placeholder. Put real credentials only in
# .env (git-ignored, never committed). With no .env at all, `docker compose up`
# still works: it falls back to the defaults baked into docker-compose.yml and
# the backend generates + prints a random admin password on first start.

# --- docker compose: Postgres/PostGIS ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-in-dot-env
POSTGRES_DB=sentinel

# --- docker compose: MinIO object storage (evidence snapshots) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-in-dot-env

# --- docker compose host ports (override to avoid clashes with local services) ---
POSTGRES_HOST_PORT=5432
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# --- first-start seed / auth ---
# ADMIN_PASSWORD blank -> the backend entrypoint generates one and prints it.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@sentinel.local
ADMIN_PASSWORD=
# Demo watchlist hit, seeded idempotently on first start. GJ18TC0450 is the
# plate in the committed demo clips (demo_assets/clips/*.mp4). Set to an empty
# string for a clean deployment with no demo data. See DEMO_RUNBOOK.md.
SEED_WATCHLIST_PLATE=GJ18TC0450
SEED_WATCHLIST_CATEGORY=Stolen Vehicle (demo)
# Shared secret between the AI pipeline and the backend ingest endpoint.
INGEST_API_KEY=dev-ingest-key

# --- AI pipeline (docker compose --profile ai) ---
# Which registry + cameras the pipeline service runs.
#   Real Sentinel cameras (default):
#     PIPELINE_REGISTRY=data/camera_registry.json
#     PIPELINE_CAMERAS=cam04,cam06
#   Mock ANPR demo (reads GJ18TC0450 -> alert -> journey across 3 cameras):
#     PIPELINE_REGISTRY=data/demo_camera_registry.json
#     PIPELINE_CAMERAS=mockcam01,mockcam02,mockcam03
PIPELINE_REGISTRY=data/camera_registry.json
PIPELINE_CAMERAS=cam04,cam06
# OCR backend: easyocr (default) | paddleocr | auto
OCR_ENGINE=easyocr

# --- backend security hardening (see SECURITY.md §2) ---
# SENTINEL_ENV drives CORS wildcard handling: a "*" in CORS_ALLOW_ORIGINS is
# dropped unless SENTINEL_ENV is development/dev/local/test.
SENTINEL_ENV=development
CORS_ALLOW_ORIGINS='["http://localhost:3000"]'
# vehicle_events retention purge in days (0 = disabled)
VEHICLE_EVENT_RETENTION_DAYS=30
# uvicorn --reload (1 = on, for local dev); unset/blank in production
UVICORN_RELOAD=1

# --- real Sentinel RTSP feeds (bare-metal / non-demo runs) ---
# Basic-auth creds injected into the stream URL just before cv2.VideoCapture();
# never logged, never sent to the frontend. Blank -> unauthenticated / local files.
SENTINEL_RTSP_USERNAME=
SENTINEL_RTSP_PASSWORD=
# Base used when a camera has no rtsp_url in the registry: <base>/<camera_id>
SENTINEL_RTSP_BASE=rtsp://103.250.160.189:8554/stream
# Stream transport default
OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp

# --- bare-metal AI pipeline -> backend (scripts/run_pipeline_service.py) ---
SENTINEL_BACKEND_URL=http://localhost:8000/api/v1/events/ai-detection
SENTINEL_INGEST_API_KEY=dev-ingest-key
