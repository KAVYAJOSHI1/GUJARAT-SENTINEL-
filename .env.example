# SENTINEL Platform Environment Configuration Template

# General Environment
ENV=production
DEBUG=false
SECRET_KEY=sentinel_gujarat_police_hackathon_2026_secret_key

# PostgreSQL + PostGIS Database
POSTGRES_USER=sentinel_admin
POSTGRES_PASSWORD=sentinel_secure_pass_2026
POSTGRES_DB=sentinel_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=sentinel_minio_admin
MINIO_SECRET_KEY=sentinel_minio_secret_2026
MINIO_BUCKET_NAME=sentinel-evidence

# Service Ports
BACKEND_PORT=8000
INGESTION_PORT=8001
FRONTEND_PORT=3000

# Stream Ingestion Default Transport
OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp

# AI pipeline -> backend
SENTINEL_BACKEND_URL=http://localhost:8000/api/v1/events/ai-detection
# Must match the backend's INGEST_API_KEY. Blank -> pipeline sends no auth header.
SENTINEL_INGEST_API_KEY=
# OCR backend: easyocr (default) | paddleocr | auto
OCR_ENGINE=easyocr
