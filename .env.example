# SENTINEL Environment Configuration Blueprint

# General Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=sentinel_gujarat_hackathon_super_secret_key_2026

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Configuration (PostgreSQL + PostGIS)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinel_db
POSTGRES_USER=sentinel_admin
POSTGRES_PASSWORD=sentinel_secure_password_2026
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# Storage & Evidence (S3 / MinIO)
STORAGE_TYPE=minio # minio or s3 or local
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=sentinel-evidence

# Stream Ingestion Service
INGESTION_SERVICE_URL=http://localhost:8001
INGEST_RTSP_TRANSPORT=tcp
RTSP_RECONNECT_MAX_BACKOFF=30

# AI Pipeline Configuration
AI_DEVICE=cuda # cuda or cpu
YOLO_MODEL_PATH=weights/yolov8n.pt
ANPR_MODEL_PATH=weights/plate_detector.pt
OCR_ENGINE=paddleocr # paddleocr or tesseract
ANPR_CONFIDENCE_THRESHOLD=0.5
OCR_CONFIDENCE_THRESHOLD=0.7

# Watchlist & Alert Engine
ALERT_WEBSOCKET_PORT=8002
WATCHLIST_MATCH_PRIORITY=CRITICAL
