# SENTINEL Live Camera & AI micro-service (compose profile "ai").
# Same base as Dockerfile.pipeline (heavy: torch/ultralytics/opencv), just a
# different entrypoint script -- kept as its own Dockerfile so the existing
# `pipeline` service definition/image is untouched.
FROM python:3.11-slim

WORKDIR /repo

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev libgl1 libglib2.0-0 ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu

COPY requirements-ai.txt .
RUN pip install --no-cache-dir -r requirements-ai.txt

COPY ai/ ./ai/
COPY ingestion/ ./ingestion/
COPY scripts/ ./scripts/

ENV PYTHONPATH=/repo

EXPOSE 8600

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
    CMD python -c "import urllib.request,os; urllib.request.urlopen('http://localhost:' + os.environ.get('LIVE_CAMERA_HTTP_PORT','8600') + '/health', timeout=3)" || exit 1

ENTRYPOINT ["python", "scripts/live_camera_ai_service.py"]
