# Copy to .env.local to override defaults.
# Base URL for Vanshal's FastAPI REST backend. Leave blank to use the
# Vite dev proxy (/api -> http://localhost:8000).
VITE_API_BASE_URL=

# Full URL for the live alert WebSocket feed (DEVELOPER_README Isha §8).
# Leave blank to derive it from the current origin (/ws/alerts).
VITE_WS_URL=
